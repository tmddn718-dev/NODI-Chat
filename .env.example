# NODI 환경변수 예시 — 값은 비워 두세요. 실제 값은 로컬 .env(gitignore) 또는 Render 대시보드에만 넣어요.
# [서버] = 브라우저에 절대 노출되지 않아요. [클라이언트] = VITE_ 접두사, 빌드 시점에 번들에 들어가므로 공개돼도 되는 값만 넣어요.

# ── 실행 모드 ─────────────────────────────────────────────
# groq(기본: API Key 입력) / demo(키 없는 시나리오 체험) / public(키 없는 공개 테스트, 서버 키로 Groq 호출)
NODI_MODE=
NODE_ENV=
PORT=
# [서버] 배포된 공개 주소(예: https://nodi-public.onrender.com). 초대 링크와 허용 Origin 기본값에 쓰여요.
NODI_PUBLIC_URL=
# [서버] 쉼표로 구분한 추가 허용 Origin(기본은 NODI_PUBLIC_URL). 같은 출처 요청은 항상 허용돼요.
ALLOWED_ORIGINS=
# [서버] 프록시 단수(Render는 1). CDN을 앞에 더 두면 올려요.
TRUST_PROXY_HOPS=

# ── Groq (public 모드) ────────────────────────────────────
# [서버·비밀] 절대 VITE_ 접두사를 붙이지 마세요.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_OUTPUT_TOKENS=
GROQ_REQUEST_TIMEOUT_MS=

# ── 사용량·예산 보호 [서버] (비우면 코드의 보수적 기본값) ─────
PUBLIC_DEMO_ENABLED=
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_PER_DAY_PER_SESSION=
RATE_LIMIT_PER_DAY_PER_IP=
MAX_INPUT_CHARS=
MAX_CONVERSATION_TURNS=
DAILY_GLOBAL_REQUEST_BUDGET=
MAX_CONCURRENT_AI_REQUESTS=
# [서버·비밀] 운영자만 /api/ops/usage를 보도록 하는 토큰(비우면 그 경로는 없는 것처럼 동작)
OPS_TOKEN=

# ── 결과 저장소 (선택) ────────────────────────────────────
# 둘 다 설정하면 Supabase에 저장하고, 없으면 data/prototype-results.jsonl(로컬 파일)에 저장해요.
SUPABASE_URL=
# [서버·비밀] service-role 키. 브라우저·VITE_ 변수에 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
PROTOTYPE_DATA_PATH=

# ── 분석 (Amplitude Browser SDK 2) [클라이언트, 빌드 시점] ──
# Project API Key만 넣어요(브라우저용, 공개 값). 비밀 키·관리 키·개인 API 키는 절대 넣지 마세요(VITE_ 변수는 번들에 들어가 공개돼요).
# 이 값이 없으면 분석만 꺼지고 앱 기능은 그대로 동작해요.
VITE_AMPLITUDE_API_KEY=
# 데이터 리전: US(기본) 또는 EU — Amplitude 프로젝트를 만든 리전과 같아야 해요.
VITE_AMPLITUDE_SERVER_ZONE=
# development / staging / production — 이벤트 속성 environment 값(운영 차트는 environment = production만 봐요)
VITE_ANALYTICS_ENVIRONMENT=
# 개발 빌드에서도 이벤트를 보내려면 true(운영 데이터에 섞이지 않게 environment=development로 구분돼요)
VITE_ANALYTICS_IN_DEV=
# 로컬 QA용 수신 서버나 자체 프록시 주소(운영에는 설정하지 마세요)
VITE_AMPLITUDE_SERVER_URL=
# 앱·흐름 버전, 실험 ID — 비우면 앱 버전은 빌드 정보(버전+커밋)로, 흐름 버전은 flow-1, 실험은 none이에요.
VITE_APP_VERSION=
VITE_FLOW_VERSION=
VITE_EXPERIMENT_ID=
# 동의 안내에 표시되는 운영자 정보(비우면 "운영자가 별도로 안내해요"로 표시)
VITE_PRIVACY_CONTACT=
VITE_DATA_RETENTION_DAYS=
